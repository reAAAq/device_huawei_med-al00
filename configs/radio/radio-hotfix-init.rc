on post-fs-data
    mkdir /data/vendor/radio 0771 radio radio
    mkdir /data/vendor/ccci_cfg 0770 system radio
    mkdir /data/vendor/mdlpm 0770 system radio
    mkdir /data/vendor/md3 0770 root system
    mkdir /mnt/vendor/nvdata/md 0770 root system
    mkdir /mnt/vendor/nvdata/md3 0770 root system
    mkdir /dev/radio 0770 radio radio
    chown radio radio /sys/kernel/ccci/boot
    setprop rild.libpath mtk-ril.so
    stop vendor.ril-daemon

on property:init.svc.vendor.ril-daemon=running
    stop vendor.ril-daemon

service vendor.ccci_fsd /vendor/bin/ccci_fsd 0
    class core
    user radio
    group radio system root
    priority -20
    ioprio rt 4
    oneshot

service vendor.ccci_rpcd /vendor/bin/ccci_rpcd 0
    class core
    user radio
    group radio system
    oneshot

service ccci_mdinit /vendor/bin/ccci_mdinit 0
    class core
    user system
    group radio system
    oneshot

service vendor.gsm0710muxd /vendor/bin/gsm0710muxd -s /dev/ttyC0 -f 512 -n 8 -m basic
    class main
    user root
    group radio cache inet misc
    disabled
    oneshot

on property:vendor.mtk.md1.status=ready
    start vendor.gsm0710muxd
    start vendor.start-mtk-ril-after-mux

service vendor.start-mtk-ril-after-mux /system/bin/sh /vendor/bin/start_mtk_ril_after_mux.sh
    class main
    user root
    group root
    disabled
    oneshot

service vendor.ril-daemon-mtk /vendor/bin/hw/mtkfusionrild -l libmtk-ril.so
    class main
    socket sap_uim_socket1 stream 660 bluetooth bluetooth
    socket rild-oem stream 660 radio system
    socket volte_imsvt1 stream 660 root radio
    socket rild-atci stream 660 radio system
    user radio
    group radio cache inet misc audio log readproc wakelock sdcard_r sdcard_rw system
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
    interface android.hardware.radio.config@1.0::IRadioConfig default
    interface android.hardware.radio.config@1.1::IRadioConfig default
    interface android.hardware.radio@1.2::IRadio slot1
    interface android.hardware.radio@1.2::IRadio slot2
    interface android.hardware.radio@1.2::ISap slot1
    interface android.hardware.radio@1.2::ISap slot2
    interface android.hardware.radio@1.4::IRadio slot1
    interface android.hardware.radio@1.4::IRadio slot2
    interface vendor.huawei.hardware.mtkradio@1.0::IMtkRadioEx mtkSlot1
    interface vendor.huawei.hardware.mtkradio@1.0::IMtkRadioEx mtkSlot2
    interface vendor.huawei.hardware.radio@2.0::IRadio slot1
    interface vendor.huawei.hardware.radio@2.0::IRadio slot2
    interface vendor.mediatek.hardware.radio_radar@1.0::IRadioRadar slot1
    interface vendor.mediatek.hardware.radio_radar@1.0::IRadioRadar slot2
    disabled
    oneshot

on property:vendor.ril.mtk=1
    start vendor.ril-daemon-mtk
