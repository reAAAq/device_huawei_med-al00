# Audio
persist.vendor.audio.tuning.def_path=odm/etc/audio/audio_param_tfa9894
ro.audio.monitorRotation=true

# Bluetooth
ro.bt.bdaddr_path=/data/vendor/bluedroid/macbt

# Display
ro.config.hw_navigationbar=true
qemu.hw.mainkeys=0
ro.sf.lcd_density=300
ro.hardware.egl=mtk

# Fastbootd
ro.fastbootd.available=true

# Media (OMX)
vendor.mtk.vdec.waitkeyframeforplay=1

# OpenGLES
ro.opengles.version=196610

# Picture Quality
persist.vendor.sys.pq.adl.idx=1
persist.vendor.sys.pq.hdr.en=1
persist.vendor.sys.pq.hfg.en=2
persist.vendor.sys.pq.iso.shp.en=2
persist.vendor.sys.pq.mdp.ccorr.en=0
persist.vendor.sys.pq.mdp.color.dbg=1
persist.vendor.sys.pq.mdp.color.idx=0
persist.vendor.sys.pq.mdp.dre.en=2
persist.vendor.sys.pq.mdp.hdrvp.dre.en=2
persist.vendor.sys.pq.mdp.vp.dre.en=1
persist.vendor.sys.pq.shp.idx=2
persist.vendor.sys.pq.ultrares.en=2
ro.vendor.mtk_pq_color_mode=1
ro.vendor.mtk_pq_support=2

# SurfaceFlinger
debug.sf.disable_backpressure=1

# USB
persist.sys.usb.config=mtp,adb

# Wi-Fi
persist.vendor.connsys.coredump.mode=2
persist.vendor.connsys.chipid=-1
persist.vendor.connsys.patch.version=-1
persist.vendor.connsys.dynamic.dump=0
ro.vendor.wlan.gen=gen4m
vendor.connsys.driver.ready=no
wifi.interface=wlan0

# Radio / IMS
rild.libpath=mtk-ril.so
persist.radio.multisim.config=dsds
persist.vendor.radio.msimmode=dsds
persist.vendor.radio.data_incall_ext=1
persist.vendor.radio.override_md_apn=0
persist.vendor.radio.ims.pdn.notify=2
persist.vendor.radio.ims.default_apn=1
persist.vendor.radio.data.oem_fd_support=1
persist.vendor.radio.fd.counter=150
persist.vendor.radio.fd.off.counter=50
persist.vendor.radio.fd.r8.counter=150
persist.vendor.radio.fd.off.r8.counter=50
persist.vendor.radio.flashless.fsm=0
persist.vendor.radio.flashless.fsm_cst=0
persist.vendor.radio.flashless.fsm_rw=0
persist.vendor.radio.mtk_dsbp_support=2
persist.vendor.radio.mtk_ps2_rat=L/W/G
persist.vendor.radio.mtk_ps3_rat=G
persist.vendor.radio.smart.data.switch=1
ro.telephony.default_network=10,10,10,10
ro.vendor.mtk_md1_support=12
ro.vendor.mtk_eccci_c2k=1
ro.vendor.num_md_protocol=2
ro.vendor.radio.max.multisim=dsds
ro.telephony.sim.count=2
telephony.lteOnCdmaDevice=1
ro.vendor.mtk_ril_mode=c6m_1rild
ro.vendor.mtk_md_world_mode_support=1
ro.vendor.mtk_rild_read_imsi=1
ro.telephony.iwlan_operation_mode=legacy

# Camera pipeline buffer counts
persist.vendor.camera3.pipeline.bufnum.min.low_ram.imgo=4
persist.vendor.camera3.pipeline.bufnum.min.low_ram.rrzo=4
persist.vendor.camera3.pipeline.bufnum.min.low_ram.lcso=4
persist.vendor.camera3.pipeline.bufnum.min.low_ram.rsso=4
persist.vendor.camera3.pipeline.bufnum.min.high_ram.imgo=4
persist.vendor.camera3.pipeline.bufnum.min.high_ram.rrzo=4
persist.vendor.camera3.pipeline.bufnum.min.high_ram.lcso=4
persist.vendor.camera3.pipeline.bufnum.min.high_ram.rsso=4
persist.vendor.camera3.pipeline.bufnum.base.imgo=1
persist.vendor.camera3.pipeline.bufnum.base.rrzo=1
persist.vendor.camera3.pipeline.bufnum.base.lcso=1
persist.vendor.camera3.pipeline.bufnum.base.rsso=1
