# Camera HAL writes MTK LSC debug/calibration dumps under /sdcard/shading_otp.
allow hal_camera_default mnt_user_file:dir search;
allow hal_camera_default mnt_user_file:lnk_file read;
allow hal_camera_default fuse:dir rw_dir_perms;
allow hal_camera_default fuse:file create_file_perms;

# Camera HAL uses GED ioctls while configuring preview/rendering pipelines.
allow hal_camera_default proc_ged:file rw_file_perms;
allowxperm hal_camera_default proc_ged:file ioctl { proc_ged_ioctls };

# MTK camera HAL requests performance boosts from the MTK power HAL.
binder_call(hal_camera_default, mtk_hal_power)
allow mtk_hal_power hal_camera_default:dir r_dir_perms;
allow mtk_hal_power hal_camera_default:file r_file_perms;

# Stock camera HAL uses MTK camera, SMI, CMDQ, GPU sync, and battery hint nodes.
allow hal_camera_default self:capability sys_nice;
allow hal_camera_default camera_isp_device:chr_file { rw_file_perms map };
allow hal_camera_default kd_camera_hw_device:chr_file rw_file_perms;
allow hal_camera_default MTK_SMI_device:chr_file rw_file_perms;
allow hal_camera_default mtk_cmdq_device:chr_file ioctl;
allow hal_camera_default gpu_device:chr_file ioctl;
allow hal_camera_default sysfs_batteryinfo:dir r_dir_perms;
allow hal_camera_default sysfs_batteryinfo:file r_file_perms;
allow hal_camera_default sysfs_boot_mode:file r_file_perms;
allow hal_camera_default debugfs_ion:dir search;

# system_server monitors the camera provider through hwbinder callbacks.
binder_call(system_server, hal_camera_default)

# Camera HAL controls flashlight and reads thermal state through stock MTK paths.
allow hal_camera_default flashlight_device:chr_file rw_file_perms;
allow hal_camera_default proc_thermal:dir search;
binder_call(hal_camera_default, system_server)
allow hal_camera_default mtk_hal_power_hwservice:hwservice_manager find;
